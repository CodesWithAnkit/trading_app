{
  "name": "trading-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "dev:backend": "npm run start:dev -w apps/backend",
    "build:backend": "npm run build -w apps/backend"
  }
}
